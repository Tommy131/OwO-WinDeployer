<Window x:Class="WinDeploy.App.Views.Launch.LauncherWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快速启动"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="False"
        SizeToContent="Height" Width="288" MinHeight="110">
  <!-- Pure-WPF frosted glass. A single smooth rounded clip (RoundClip) shapes EVERY layer, so blur and corners
       are one anti-aliased whole — no jagged region + tint mismatch. Layer 1 is the screen behind the widget
       (grabbed in code-behind, the widget excluded from capture) blurred by a WPF BlurEffect; layer 2 is the
       theme/see-through tint; layer 3 is the content. -->
  <Grid x:Name="RootGrid">
    <Grid.Clip>
      <RectangleGeometry x:Name="RoundClip" RadiusX="16" RadiusY="16" Rect="0,0,288,120" />
    </Grid.Clip>

    <!-- Layer 1: blurred capture of whatever is behind the widget. Painted as a Border BACKGROUND brush (not an
         Image element) on purpose — a background brush contributes NOTHING to layout size, so the captured
         bitmap's dimensions can't feed back into SizeToContent and grow the window. Margin is set in code to
         overscan the clip so the blur has real neighbouring pixels at the edges (no dark fade). -->
    <Border x:Name="BgLayer" IsHitTestVisible="False">
      <Border.Effect>
        <BlurEffect x:Name="BgBlur" Radius="34" KernelType="Gaussian" RenderingBias="Performance" />
      </Border.Effect>
    </Border>

    <!-- Layer 2: material tint (theme colour + user see-through; set in code). -->
    <Border x:Name="TintLayer" IsHitTestVisible="False" />

    <!-- Layer 3: content -->
    <Border Padding="4,4,4,8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: doubles as the drag handle (see code-behind). -->
        <Grid x:Name="Header" Grid.Row="0" Background="Transparent" Margin="8,6,6,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="🚀" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" />
          <TextBlock Grid.Column="1" Text="{DynamicResource S.launcher.title}" FontSize="13" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
          <Button Grid.Column="2" x:Name="PinButton" Content="📌" Width="24" Height="22" Padding="0" FontSize="12"
                  Background="Transparent" BorderThickness="0" Cursor="Hand"
                  Foreground="{DynamicResource TextSecondary}" ToolTip="{DynamicResource S.widget.pin}" />
          <Button Grid.Column="3" x:Name="CloseButton" Content="✕" Width="24" Height="22" Padding="0"
                  Background="Transparent" BorderThickness="0" Cursor="Hand"
                  Foreground="{DynamicResource TextSecondary}" ToolTip="{DynamicResource S.widget.close}" />
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderSoft}" Margin="8,0,8,4" />

        <!-- Empty hint -->
        <TextBlock Grid.Row="2" Text="{DynamicResource S.widget.empty}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondary}" Margin="14,14,14,14" TextAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="420">
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <!-- Whole row is a borderless button that launches the item on click. -->
                <Button Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" BorderThickness="0" HorizontalContentAlignment="Stretch"
                        Cursor="Hand" Padding="8,6" Margin="4,1" ToolTip="{Binding Subtitle}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBg}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Real app icon when available, else the kind glyph -->
                    <Grid Grid.Column="0" Width="20" Height="20" Margin="0,0,9,0" VerticalAlignment="Center">
                      <Image Source="{Binding Icon}" SnapsToDevicePixels="True"
                             Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                      <TextBlock Text="{Binding KindGlyph}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Visibility="{Binding ShowGlyph, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</Window>
