<UserControl x:Class="WinDeploy.App.Views.Launch.LaunchCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="24,18,24,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="{DynamicResource S.launcher.title}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{DynamicResource S.launcher.subtitle}"
                 FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
      <Button Content="{DynamicResource S.launcher.add}" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" />
      <Button Content="{DynamicResource S.launcher.clearDone}" Style="{StaticResource MiniButton}" Margin="8,0,0,0" Command="{Binding ClearDoneCommand}" />
      <Button Content="{Binding OpenWidgetLabel}" Style="{StaticResource MiniButton}" Margin="8,0,0,0" Command="{Binding OpenWidgetCommand}" />
    </StackPanel>

    <!-- Margin right -24 / Padding right 24: scrollbar flush at the page's outer edge, content unchanged. -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,12,-24,0" Padding="0,0,24,0">
      <Grid>
        <!-- Empty state -->
        <Border Style="{StaticResource Card}" Padding="20,28" Margin="0,0,0,8"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="🚀" FontSize="30" HorizontalAlignment="Center" />
            <TextBlock Text="{DynamicResource S.launcher.empty}" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                       Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8">
                <Border.InputBindings>
                  <MouseBinding MouseAction="LeftDoubleClick"
                                Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                </Border.InputBindings>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <!-- Done checkbox -->
                  <CheckBox Grid.Column="0" IsChecked="{Binding Done, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"
                            ToolTip="{DynamicResource S.launcher.done.tip}" />

                  <!-- Real app icon when available, else the kind glyph -->
                  <Grid Grid.Column="1" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Image Source="{Binding Icon}" SnapsToDevicePixels="True"
                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding KindGlyph}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ShowGlyph, Converter={StaticResource BoolToVis}}" />
                  </Grid>

                  <!-- Title + target -->
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Done}" Value="True">
                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                <Setter Property="Opacity" Value="0.5" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <Border CornerRadius="6" Padding="6,1" Margin="8,0,0,0" Background="{DynamicResource WarnBg}" VerticalAlignment="Center"
                              Visibility="{Binding RunAsAdmin, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource S.launcher.badge.admin}" FontSize="10" Foreground="{DynamicResource WarnFg}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>

                  <!-- Actions -->
                  <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{DynamicResource S.launcher.open}" Style="{StaticResource InfoButton}" MinWidth="56"
                            Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <Button Content="▲" Style="{StaticResource MiniButton}" Margin="6,0,0,0" ToolTip="{DynamicResource S.launcher.moveUp}"
                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <Button Content="▼" Style="{StaticResource MiniButton}" Margin="4,0,0,0" ToolTip="{DynamicResource S.launcher.moveDown}"
                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <Button Content="{DynamicResource S.launcher.edit}" Style="{StaticResource MiniButton}" Margin="6,0,0,0"
                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <Button Content="{DynamicResource S.launcher.delete}" Style="{StaticResource MiniButton}" Margin="4,0,0,0"
                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
