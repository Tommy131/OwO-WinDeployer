<UserControl x:Class="OwOWinDeployer.App.Views.Shell.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="24,18,24,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="{DynamicResource S.about.title}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{DynamicResource S.about.subtitle}" FontSize="13"
                 Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,-24,0" Padding="0,0,24,0">
      <StackPanel>

        <!-- Non-commercial disclaimer (prominent) -->
        <Border Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource WarnFg}" BorderThickness="1"
                CornerRadius="10" Padding="16">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource WarnFg}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="{DynamicResource S.about.disclaimer.title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource WarnFg}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{DynamicResource S.about.disclaimer.body}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"
                       TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" />
            <TextBlock FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0">
              <Run Text="{DynamicResource S.about.disclaimer.commercial}" Foreground="{DynamicResource TextPrimary}" /><Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="{Binding MailUrl}" Foreground="{DynamicResource Accent}"><Run Text="{Binding Email, Mode=OneWay}" /></Hyperlink>
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- Identity + edition -->
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding AppName}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Border Background="{DynamicResource AccentBg}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                      CornerRadius="10" Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource S.about.edition}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
              </Border>
            </StackPanel>
            <TextBlock FontSize="13" Margin="0,8,0,0">
              <Run Text="{DynamicResource S.about.versionLabel}" Foreground="{DynamicResource TextSecondary}" /><Run Text="{Binding Version, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock Text="{Binding Copyright, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource TextTertiary}" Margin="0,4,0,0" />
            <TextBlock FontSize="12" Foreground="{DynamicResource TextTertiary}" Margin="0,2,0,0">
              <Run Text="{DynamicResource S.about.licenseLabel}" /><Run Text="{Binding License, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- Update -->
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource S.about.update.title}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
              <Button Content="{DynamicResource S.settings.about.checkUpdate}" Style="{StaticResource PrimaryButton}" Command="{Binding CheckUpdateCommand}"
                      ToolTip="{DynamicResource S.settings.about.checkUpdateTip}" />
              <Button Content="{DynamicResource S.settings.about.openDataDir}" Style="{StaticResource MiniButton}" Command="{Binding OpenFolderCommand}" Margin="8,0,0,0"
                      ToolTip="{DynamicResource S.settings.about.openDataDirTip}" />
              <TextBlock Text="{Binding UpdateNote}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
            <CheckBox Content="{DynamicResource S.settings.update.prerelease}" IsChecked="{Binding PreReleaseUpdates}" FontSize="13" Margin="0,12,0,0" />
            <TextBlock Text="{DynamicResource S.settings.update.prereleaseDesc}" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <Border Visibility="{Binding IsRunningPrerelease, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource WarnFg}" BorderThickness="1"
                    CornerRadius="6" Padding="10,7" Margin="0,10,0,0">
              <TextBlock Text="{DynamicResource S.settings.update.runningPrerelease}" FontSize="12"
                         Foreground="{DynamicResource WarnFg}" TextWrapping="Wrap" />
            </Border>
            <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiary}" Margin="0,10,0,0" TextWrapping="Wrap">
              <Run Text="{DynamicResource S.settings.about.dataDir}" /><Run Text="{Binding SettingsPath, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- Developer -->
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource S.settings.aboutDev.title}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="68" Height="68" VerticalAlignment="Top">
                <Ellipse.Fill>
                  <ImageBrush ImageSource="{Binding AuthorAvatar}" Stretch="UniformToFill" />
                </Ellipse.Fill>
              </Ellipse>
              <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6">
                  <Run Text="{Binding AuthorName, Mode=OneWay}" /><Run Text="  ·  GitHub: " FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" FontSize="12" /><Run Text="{Binding AuthorGitHub, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                </TextBlock>
                <TextBlock FontSize="12" Margin="0,2,0,0">
                  <Run Text="{DynamicResource S.settings.aboutDev.github}" Foreground="{DynamicResource TextSecondary}" /><Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="{Binding GitHubUrl}" Foreground="{DynamicResource Accent}"><Run Text="{Binding GitHubUrl, Mode=OneWay}" /></Hyperlink>
                </TextBlock>
                <TextBlock FontSize="12" Margin="0,2,0,0">
                  <Run Text="{DynamicResource S.settings.aboutDev.email}" Foreground="{DynamicResource TextSecondary}" /><Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="{Binding MailUrl}" Foreground="{DynamicResource Accent}"><Run Text="{Binding Email, Mode=OneWay}" /></Hyperlink>
                </TextBlock>
                <TextBlock FontSize="12" Margin="0,2,0,0">
                  <Run Text="{DynamicResource S.settings.aboutDev.donation}" Foreground="{DynamicResource TextSecondary}" /><Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="{Binding DonationUrl}" Foreground="{DynamicResource Accent}"><Run Text="{Binding DonationUrl, Mode=OneWay}" /></Hyperlink>
                </TextBlock>
                <TextBlock FontSize="12" Margin="0,2,0,0">
                  <Run Text="{DynamicResource S.settings.aboutDev.service}" Foreground="{DynamicResource TextSecondary}" /><Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="{Binding ServiceUrl}" Foreground="{DynamicResource Accent}"><Run Text="{Binding ServiceUrl, Mode=OneWay}" /></Hyperlink>
                </TextBlock>
                <TextBlock FontSize="12" Margin="0,2,0,0">
                  <Run Text="{DynamicResource S.settings.aboutDev.blog}" Foreground="{DynamicResource TextSecondary}" /><Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="{Binding BlogUrl}" Foreground="{DynamicResource Accent}"><Run Text="{Binding BlogUrl, Mode=OneWay}" /></Hyperlink>
                </TextBlock>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Third-party dependencies -->
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,18">
          <StackPanel>
            <TextBlock Text="{DynamicResource S.about.deps.title}" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource S.about.deps.subtitle}" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,10" />
            <ItemsControl ItemsSource="{Binding Dependencies}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="0,8">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Version}" FontSize="11.5" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Border Background="{DynamicResource OkBg}" CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding License}" FontSize="10.5" Foreground="{DynamicResource OkFg}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Desc}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                      <TextBlock FontSize="11.5" Margin="0,2,0,0">
                        <Hyperlink Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding Url}" Foreground="{DynamicResource Accent}"><Run Text="{Binding Url, Mode=OneWay}" /></Hyperlink>
                      </TextBlock>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
