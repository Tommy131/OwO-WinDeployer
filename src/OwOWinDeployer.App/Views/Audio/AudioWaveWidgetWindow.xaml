<Window x:Class="OwOWinDeployer.App.Views.Audio.AudioWaveWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音频波形"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="CanResize" Topmost="False"
        Width="360" Height="216" MinWidth="280" MinHeight="176" MaxWidth="960" MaxHeight="620">
  <!-- Same pure-WPF frosted glass as the Quick Launch widget: one rounded clip (RoundClip) shapes every layer so
       blur + corners are a single anti-aliased whole. Layer 1 = blurred capture of the screen behind (grabbed in
       code-behind, this window excluded from capture); layer 2 = theme/see-through tint; layer 3 = content. -->
  <Grid x:Name="RootGrid">
    <Grid.Clip>
      <RectangleGeometry x:Name="RoundClip" RadiusX="16" RadiusY="16" Rect="0,0,360,176" />
    </Grid.Clip>

    <Border x:Name="BgLayer" IsHitTestVisible="False">
      <Border.Effect>
        <BlurEffect x:Name="BgBlur" Radius="34" KernelType="Gaussian" RenderingBias="Performance" />
      </Border.Effect>
    </Border>

    <Border x:Name="TintLayer" IsHitTestVisible="False" />

    <Border Padding="4,4,4,6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: doubles as the drag handle (see code-behind). -->
        <Grid x:Name="Header" Grid.Row="0" Background="Transparent" Margin="8,6,6,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="🎵" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" />
          <TextBlock Grid.Column="1" Text="{DynamicResource S.audiowave.title}" FontSize="13" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="2" x:Name="StyleButton" Content="🌀" Width="24" Height="22" Padding="0" FontSize="12"
                  Background="Transparent" BorderThickness="0" Cursor="Hand"
                  Foreground="{DynamicResource TextSecondary}" ToolTip="{DynamicResource S.audiowave.cycleStyle}" />
          <Button Grid.Column="3" x:Name="ColorButton" Content="🎨" Width="24" Height="22" Padding="0" FontSize="12"
                  Background="Transparent" BorderThickness="0" Cursor="Hand"
                  Foreground="{DynamicResource TextSecondary}" ToolTip="{DynamicResource S.audiowave.cycleColor}" />
          <Button Grid.Column="4" x:Name="PinButton" Content="📌" Width="24" Height="22" Padding="0" FontSize="12"
                  Background="Transparent" BorderThickness="0" Cursor="Hand"
                  Foreground="{DynamicResource TextSecondary}" ToolTip="{DynamicResource S.widget.pin}" />
          <Button Grid.Column="5" x:Name="CloseButton" Content="✕" Width="24" Height="22" Padding="0"
                  Background="Transparent" BorderThickness="0" Cursor="Hand"
                  Foreground="{DynamicResource TextSecondary}" ToolTip="{DynamicResource S.widget.close}" />
        </Grid>

        <!-- Visualization host (Row 1, star): waveform centred here. WaveformRenderer inserted in code-behind. -->
        <Grid Grid.Row="1" Margin="8,2,8,2">
          <Border x:Name="VizHost" />
          <!-- Readout sits in a translucent rounded chip so the waveform behind it never obscures the text. -->
          <Border x:Name="ReadoutChip" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,2"
                  CornerRadius="5" Padding="6,2" IsHitTestVisible="False" Visibility="Collapsed">
            <Border.Background>
              <SolidColorBrush Color="#000000" Opacity="0.42" />
            </Border.Background>
            <TextBlock x:Name="Readout" FontSize="10.5" FontFamily="Cascadia Mono, Consolas"
                       Foreground="#F0F0F0" />
          </Border>
          <TextBlock x:Name="NoDeviceHint" Text="{DynamicResource S.audiowave.noDevice}" FontSize="12"
                     Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center"
                     VerticalAlignment="Center" Visibility="Collapsed" Margin="10,0" />
        </Grid>

        <!-- Now Playing strip (Row 2, bottom): album art + title/artist + progress bar. Collapsed when idle.
             Placing it below the waveform (with the header above) keeps the waveform vertically centred. -->
        <Grid x:Name="NowPlayingBar" Grid.Row="2" Margin="10,2,10,7" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6" SnapsToDevicePixels="True">
            <Border.Background>
              <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill" />
            </Border.Background>
          </Border>
          <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="TrackTitle" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="TrackArtist" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
            <Grid x:Name="ProgressRow" Margin="0,4,0,0" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <!-- SeekArea is a taller transparent hit target (drag to seek); the 3px track sits inside it. -->
              <Border x:Name="SeekArea" Grid.Column="0" Height="14" Background="Transparent" Cursor="Hand" VerticalAlignment="Center">
                <Border x:Name="ProgTrack" Height="3" CornerRadius="2" VerticalAlignment="Center"
                        Background="{DynamicResource BorderSoft}" HorizontalAlignment="Stretch">
                  <Border x:Name="ProgFill" Height="3" CornerRadius="2" Width="0" HorizontalAlignment="Left"
                          Background="{DynamicResource Accent}" />
                </Border>
              </Border>
              <TextBlock x:Name="ProgTime" Grid.Column="1" Margin="8,0,0,0" FontSize="10"
                         FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextTertiary}"
                         VerticalAlignment="Center" />
            </Grid>
          </StackPanel>

          <!-- Transport controls (shown per the player's reported capabilities). -->
          <StackPanel x:Name="TransportBar" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
            <Button x:Name="PrevButton" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" ToolTip="{DynamicResource S.audiowave.prev}">
              <TextBlock Text="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondary}" />
            </Button>
            <Button x:Name="PlayPauseButton" Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" ToolTip="{DynamicResource S.audiowave.playPause}">
              <TextBlock x:Name="PlayPauseGlyph" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextPrimary}" />
            </Button>
            <Button x:Name="NextButton" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" ToolTip="{DynamicResource S.audiowave.next}">
              <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondary}" />
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
